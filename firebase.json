{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "server.py",
      "__pycache__/**",
      "*.md",
      "*.py",
      ".agents/**",
      ".vercel/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/api/lookbook",
        "destination": "/lookbook.json"
      },
      {
        "source": "/api/catalogo",
        "destination": "/catalogo.json"
      },
      {
        "source": "/api/noticias",
        "destination": "/noticias.json"
      },
      {
        "source": "/api/news",
        "destination": "/noticias.json"
      },
      {
        "source": "/api/reseñas",
        "destination": "/reseñas.json"
      },
      {
        "source": "/api/resenas",
        "destination": "/reseñas.json"
      },
      {
        "source": "/api/faq",
        "destination": "/faq.json"
      },
      {
        "source": "/api/pedidos",
        "destination": "/pedidos.json"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
